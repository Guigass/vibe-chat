# =============================================================================
# VibeChat — local development environment variables
# Copy to `.env` and adjust as needed. NEVER use these values in production.
# All passwords below are FAKE DEMO credentials for local Docker only.
# =============================================================================

# --- Compose project ---
COMPOSE_PROJECT_NAME=vibechat

# --- PostgreSQL (source of truth) ---
POSTGRES_IMAGE=postgres:16.6
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vibechat
POSTGRES_USER=vibechat
POSTGRES_PASSWORD=vibechat_dev_password_change_me
# Separate DB for Keycloak (created by init script)
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password_change_me

# Connection string used by API / Worker (host networking from host machine)
DATABASE_URL="Host=localhost;Port=5432;Database=vibechat;Username=vibechat;Password=vibechat_dev_password_change_me"

# --- Redis (cache / presence / SignalR backplane — NOT durable source of truth) ---
REDIS_IMAGE=redis:7.4-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Keycloak ---
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.2
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password_change_me
KEYCLOAK_REALM=vibechat
KEYCLOAK_HOSTNAME=localhost
# Issuer used by apps from the host
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/vibechat
# Demo users (imported via realm JSON): demo@ / alice@ / bob@ vibechat.local — Demo123!

# OIDC clients
OIDC_WEB_CLIENT_ID=vibechat-web
OIDC_API_AUDIENCE=vibechat-api
OIDC_WEB_REDIRECT_URI=http://localhost:4200/*
OIDC_WEB_POST_LOGOUT_REDIRECT_URI=http://localhost:4200/

# --- MinIO (S3-compatible object storage) ---
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=vibechat
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1

# --- Mailpit (profile: tools) — SMTP de desenvolvimento (D-10) ---
MAILPIT_IMAGE=axllent/mailpit:v1.21.0
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Produção: SMTP genérico configurável (sem vendor locked). Nunca commitar secrets reais.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@CHANGE_ME.local
SMTP_USE_STARTTLS=false

# --- AI (D-06 / ADR-012) — off por default em produção; mock local no seed demo ---
AI_EXTERNAL_ENABLED=false
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Observability (profile: observability) ---
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.115.1
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:11.4.0
LOKI_IMAGE=grafana/loki:3.2.1
TEMPO_IMAGE=grafana/tempo:2.6.1

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_password_change_me
LOKI_PORT=3100
TEMPO_PORT=3200

# --- Application (optional compose services / local task dev) ---
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
WEB_PORT=4200
API_BASE_URL=http://localhost:5080
WEB_BASE_URL=http://localhost:4200
DOTNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
NODE_IMAGE=node:22.12-alpine
NGINX_IMAGE=nginx:1.27.3-alpine

# Seed (infra/scripts/seed.sh) — Development only
SEED_API_URL=http://localhost:5080/api/v1/dev/seed
