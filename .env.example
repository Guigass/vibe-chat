# =============================================================================
# VibeChat — local development environment variables
# Copy to `.env` and adjust as needed. NEVER use these values in production.
# All passwords below are FAKE DEMO credentials for local Docker only.
# =============================================================================

# --- Compose project ---
COMPOSE_PROJECT_NAME=vibechat
# Local/CI: base + host ports. Coolify: only compose.yaml (do not load compose.dev.yaml).
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# --- PostgreSQL (source of truth) ---
POSTGRES_IMAGE=postgres:16.6
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vibechat
POSTGRES_USER=vibechat
POSTGRES_PASSWORD=vibechat_dev_password_change_me
# SEC-RLS-RUNTIME / ADR-009 — separate roles (never reuse bootstrap owner for API/Worker)
POSTGRES_APP_USER=vibechat_app
POSTGRES_APP_PASSWORD=vibechat_app_password_change_me
POSTGRES_MIGRATOR_USER=vibechat_migrator
POSTGRES_MIGRATOR_PASSWORD=vibechat_migrator_password_change_me
POSTGRES_BACKUP_USER=vibechat_backup
POSTGRES_BACKUP_PASSWORD=vibechat_backup_password_change_me
# Separate DB for Keycloak (created by init script)
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password_change_me

# Runtime connection (API / Worker) — app role without ownership/BYPASSRLS
DATABASE_URL="Host=localhost;Port=5432;Database=vibechat;Username=vibechat_app;Password=vibechat_app_password_change_me"
# Migrator connection (EF migrations / seed / RLS catalog) — not delivered to request path
DATABASE_MIGRATOR_URL="Host=localhost;Port=5432;Database=vibechat;Username=vibechat_migrator;Password=vibechat_migrator_password_change_me"
# Bootstrap/owner (role creation only; docker POSTGRES_USER)
DATABASE_BOOTSTRAP_URL="Host=localhost;Port=5432;Database=vibechat;Username=vibechat;Password=vibechat_dev_password_change_me"

# --- Redis (cache / presence / SignalR backplane — NOT durable source of truth) ---
REDIS_IMAGE=redis:7.4-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# B-144 — perfil HA opcional. false mantém o Standard de um nó.
Ha__Enabled=false

# --- Keycloak ---
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.2
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password_change_me
KEYCLOAK_REALM=vibechat
KEYCLOAK_HOSTNAME=localhost
# Public URL seen by the browser (Coolify/TLS). Defaults to http://localhost:$KEYCLOAK_HTTP_PORT
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Path prefix for API MetadataAddress interpolation (staging: /auth). Leave empty for lab.
# Do NOT map empty into KC_HTTP_RELATIVE_PATH — Keycloak 26 NPE. Staging Coolify must set
# container env KC_HTTP_RELATIVE_PATH=/auth explicitly (same value as below).
KEYCLOAK_HTTP_RELATIVE_PATH=
# When KEYCLOAK_HTTP_RELATIVE_PATH=/auth, set KEYCLOAK_HOSTNAME to the full public
# URL including /auth (ex.: https://chat.example.com/auth). Hostname-only full URL
# without the path makes OIDC issuer/redirects omit /auth and break behind nginx.
# Issuer used by apps (must match JWT `iss`)
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/vibechat
# Coolify/Traefik TLS termination. Empty is invalid — Keycloak 26 rejects KC_PROXY_HEADERS="".
# Default in compose.yaml is xforwarded; override with forwarded if needed.
KEYCLOAK_PROXY_HEADERS=xforwarded
# Lab realm (com alice/bob/demo). Staging: ./infra/keycloak/realm-vibechat.staging.json
KEYCLOAK_REALM_IMPORT_FILE=./infra/keycloak/realm-vibechat.json
# B-128: SCIM 2.0 stays off until ops enables it. The Keycloak adapter is optional.
IDENTITY_SCIM_ENABLED=false
IDENTITY_SCIM_KEYCLOAK_ADAPTER=false
# B-164: broker directory client (dev placeholder). Flag stays off until ops enables it.
IDENTITY_SSO_ENABLED=false
SSO_DIRECTORY_CLIENT_SECRET=sso_directory_dev_change_me
# Demo users (imported via realm JSON): demo@ / alice@ / bob@ vibechat.local — Demo123!
# Staging realm only: one-time password for the imported initial admin (temporary).
VIBECHAT_INITIAL_ADMIN_PASSWORD=

# OIDC clients
OIDC_WEB_CLIENT_ID=vibechat-web
OIDC_API_AUDIENCE=vibechat-api
OIDC_WEB_REDIRECT_URI=http://localhost:4200/*
OIDC_WEB_POST_LOGOUT_REDIRECT_URI=http://localhost:4200/

# --- MinIO (S3-compatible object storage) ---
# Docker Hub dropped minio/* (~2026-09-12); Quay historical tags are unauthorized on GHA.
MINIO_IMAGE=alpine/minio:RELEASE.2025-10-15T17-29-55Z
MINIO_MC_IMAGE=amazon/aws-cli:2.27.50
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=vibechat
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
# Community MinIO: global CORS only (bucket CORS / mc cors set is AIStor-only).
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:4200,https://localhost:4200,*

# --- Mailpit (profile: tools) — SMTP de desenvolvimento (D-10) ---
MAILPIT_IMAGE=axllent/mailpit:v1.21.0
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Produto (SMTP/IA/retenção/push/VAPID/flags) configura-se em /admin/settings (B-187).

# --- Runtime settings / AES-GCM keyring (ADR-020 / B-187) ---
# Keyring demo de lab (32 bytes). Produção: openssl rand -base64 32 e trocar antes de ligar overrides.
# CHANGE_ME* ou chave ausente → criptografia indisponível (secrets fail-closed).
RuntimeSettings__DatabaseOverridesEnabled=true
Features__LegalHold__Enabled=false
Features__Dlp__Enabled=false
Features__Siem__Enabled=false
Features__PolicyPacks__Enabled=false
Features__DelegatedAdmin__Enabled=false
Features__CapacitySlo__Enabled=false
# B-145: ciclo de vida de objetos. Off por default. Chave vazia ou CHANGE_ME mantém a CDN em 404.
# Não coloque segredo de produção aqui.
Features__ChatBackup__Enabled=false
Features__ChatBackup__DriveEnabled=false
Features__ChatBackup__DriveEndpoint=
Features__StorageLifecycle__Enabled=false
Features__StorageLifecycle__CdnEnabled=false
Features__StorageLifecycle__CdnKey=
Features__StorageLifecycle__CdnTtlSeconds=120
Features__StorageLifecycle__GraceHours=24
Features__Plugins__Enabled=false
Integrations__PluginSdk__Enabled=false
Integrations__PluginRegistry__Enabled=false
Integrations__Bridges__Enabled=false
Integrations__Bridges__InstanceId=
Integrations__Bridges__PinnedHosts__0=
# B-064: canais confidenciais. Off até revisão criptográfica independente.
Messaging__E2ee__Enabled=false
# B-147: huddle de áudio/vídeo. Off por default. Profile Compose `live` (ADR-065).
# Provider none|dev|livekit|down. Segredo vazio não emite token LiveKit.
Features__Live__Enabled=false
Features__Live__VideoEnabled=false
Features__Live__ShareEnabled=false
Features__Live__RecordingEnabled=false
Features__Live__RecordingRetentionDays=7
Features__Live__RecordingQuotaBytes=33554432
Features__Live__DownloadTtlSeconds=60
Features__Live__Provider=none
Features__Live__MaxParticipants=8
Features__Live__MaxSessionsPerWorkspace=2
Features__Live__TokenTtlSeconds=60
Features__Live__DevSigningKey=
Features__Live__LiveKit__Url=
Features__Live__LiveKit__ApiKey=
Features__Live__LiveKit__ApiSecret=
Features__MeetingAi__Enabled=false
Features__MeetingAi__Provider=none
# B-065: federação S2S. Off por default. Sem discovery pública.
Integrations__Federation__Enabled=false
Integrations__Federation__InstanceId=
Integrations__Federation__AllowedDomains__0=
Integrations__Federation__ClockSkewSeconds=300
Integrations__Federation__MaxTtlSeconds=600
# B-140: mapa operador host→tenant. Vazio mantém a marca oficial no login público.
# Branding__Hosts__chat.example=00000000-0000-0000-0000-000000000000
# B-141: cliente desktop. Off por default. Feed vazio = sem auto-update.
# Não coloque certificado nem chave privada aqui.
# Desktop__Enabled=false
# Desktop__AllowedHosts__0=
# Desktop__UpdateFeedUrl=
# Desktop__UpdatePublicKeyPem=
# Desktop__SigningCredentialRef=
# B-063: cliente mobile. Off por default. Sem conta de loja, a distribuição é sideload.
# Não coloque token, senha ou PEM aqui.
# Mobile__Enabled=false
# Mobile__AllowedHosts__0=
# Mobile__StoreCredentialRef=
# B-143: fila offline. Off por default. A chave só assina o cursor; não é segredo de conteúdo.
# Vazio ou CHANGE_ME mantém a rota em 404 OfflineWriteDisabled. Sem PEM e sem token.
# Features__OfflineWrite__Enabled=false
# Features__OfflineWrite__CursorKey=
RuntimeSettings__Encryption__ActiveKeyVersion=1
RuntimeSettings__Encryption__Keys__1=VmliZUNoYXRMYWJLZXlyaW5nRGVtb09ubHkhISEhISE=

# --- Observability (profile: observability) ---
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.115.1
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2
GRAFANA_IMAGE=grafana/grafana:11.4.0
LOKI_IMAGE=grafana/loki:3.2.1
TEMPO_IMAGE=grafana/tempo:2.6.1

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_password_change_me
# Same-origin path edge (staging): https://host/grafana + SERVE_FROM_SUB_PATH=true
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_SERVE_FROM_SUB_PATH=false
LOKI_PORT=3100
TEMPO_PORT=3200

# --- Application (Compose profile apps = official self-host, B-074 / W6-8) ---
# task apps  →  docker compose -f compose.yaml -f compose.dev.yaml --profile apps up -d --build
# DX hot-reload (API/Web on host): task setup && task dev
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
WEB_PORT=4200
API_BASE_URL=http://localhost:5080
WEB_BASE_URL=http://localhost:4200
# Apply EF migrations + RLS catalog on API startup. Useful for staging/first boot;
# keep false in production when migrations run as a dedicated release job.
DATABASE_BOOTSTRAP_ON_STARTUP=false
# Idempotent first-workspace bootstrap for a clean staging environment. This is
# separate from demo seed data and requires BOOTSTRAP_INITIAL_ADMIN_EMAIL.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_INITIAL_ADMIN_EMAIL=
BOOTSTRAP_WORKSPACE_NAME=VibeChat Alpha
BOOTSTRAP_WORKSPACE_SLUG=vibechat-alpha
# Demo/lab seed on API startup (compose default is false; set true for local lab)
SEED_ENABLED=true
# Web build: show Alice/Bob/Demo DevAuth on login (task apps). Coolify/prod: false.
ENABLE_DEV_AUTH=true
DOTNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
NODE_IMAGE=node:22.22.3-alpine
NGINX_IMAGE=nginx:1.27.3-alpine

# --- TLS / proxy reference (profile: proxy) — W5-2 / D-05 ---
# Generate local self-signed certs: ./infra/proxy/generate-dev-certs.sh
# Production: mount real fullchain.pem + privkey.pem; never commit secrets.
PROXY_HTTP_PORT=8088
PROXY_HTTPS_PORT=8443
PROXY_PUBLIC_URL=https://localhost:8443
# Optional ACME / public hostname placeholders (CHANGE_ME in real deploys)
TLS_DOMAIN=CHANGE_ME.example
TLS_EMAIL=ops@CHANGE_ME.example
TLS_CERT_PATH=./infra/proxy/certs/fullchain.pem
TLS_KEY_PATH=./infra/proxy/certs/privkey.pem

# Load smoke (W5-3) — DevAuth path against local API
K6_IMAGE=grafana/k6:0.54.0
LOAD_API_BASE=http://localhost:5080
LOAD_DEV_USER=alice
LOAD_CHANNEL_ID=22222222-2222-2222-2222-222222222222

# Seed (infra/scripts/seed.sh) — Development only
SEED_API_URL=http://localhost:5080/api/v1/dev/seed

# Optional Qdrant (profile: ai, B-121 / ADR-019). Empty keeps retrieval on the
# postgres chunk projection. No public port in the compose reference.
QDRANT_IMAGE=qdrant/qdrant:v1.13.4
QDRANT_URL=
