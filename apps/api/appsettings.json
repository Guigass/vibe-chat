{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Enabled": false,
    "Provider": "Mock",
    "OpenRouter": {
      "ApiKey": "",
      "BaseUrl": "https://openrouter.ai/api/v1"
    }
  },
  "Email": {
    "Enabled": false,
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Username": "",
      "Password": "",
      "From": "noreply@localhost",
      "UseStartTls": false
    }
  },
  "MessageRetention": {
    "Enabled": false,
    "DefaultRetentionDays": 90,
    "BatchSize": 500,
    "IntervalMinutes": 60
  },
  "RuntimeSettings": {
    "DatabaseOverridesEnabled": false,
    "Encryption": {
      "ActiveKeyVersion": 1,
      "Keys": {
        "1": ""
      }
    }
  },
  "RateLimit": {
    "SendPerMinute": 60,
    "HubPerMinute": 120
  },
  "Files": {
    "MaxSizeBytes": 10485760,
    "MaxAttachmentsPerMessage": 10,
    "PresignUploadTtlSeconds": 900,
    "PresignDownloadTtlSeconds": 300
  }
}
